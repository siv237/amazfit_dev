{
  "configVersion": "v3",
  "app": {
    "appId": 25070,
    "appName": "GPS Test",
    "appType": "app",
    "version": {
      "code": 1,
      "name": "1.0.0"
    },
    "icon": "icon.png",
    "vender": "zepp",
    "description": "Показ координат GPS (Geolocation) для отладки симулятора"
  },
  "permissions": [
    "data:os.device.info",
    "device:os.local_storage",
    "device:os.geolocation",
    "device:os.compass",
    "device:os.accelerometer",
    "device:os.gyroscope",
    "device:os.barometer"
  ],
  "runtime": {
    "apiVersion": {
      "compatible": "3.0.0",
      "target": "3.0.0",
      "minVersion": "3.0"
    }
  },
  "targets": {
    "common": {
      "module": {
        "page": {
          "pages": [
            "page/index"
          ]
        }
      },
      "platforms": [
        {
          "st": "r",
          "dw": 480
        },
        {
          "st": "s",
          "dw": 390
        }
      ]
    }
  },
  "i18n": {
    "en-US": {
      "appName": "GPS Test"
    }
  },
  "defaultLanguage": "en-US"
}
